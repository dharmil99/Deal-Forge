# DealForge Application Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with real credentials.

# --- Core Application ---
DEALFORGE_ENVIRONMENT=development
DEALFORGE_DEBUG=false

# --- AI & RAG Subsystem ---
RAG_ENABLED=true

# Embedding Provider: "ollama" (local) or "gemini" (remote)
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini Embedding Configuration (Required if RAG_EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=3072

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dealforge_methodology
QDRANT_API_KEY=

# Chunking Parameters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
